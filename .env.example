# Public client configuration; copy to .env.local and supply your project values.
VITE_SUPABASE_URL=
# Preferred current public key name:
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy public key name is still supported:
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase Edge Function secrets (never prefix with VITE_):
# SUPABASE_URL=        # supplied automatically by Supabase
# SUPABASE_ANON_KEY=   # supplied automatically by Supabase
# OCR_SPACE_API_KEY=
# GEMINI_API_KEY=               # youtube-import: Google AI Studio key; set with `supabase secrets set`
# GEMINI_MODEL=gemini-3.8-flash # optional override
# GEMINI_TIMEOUT_MS=120000      # optional, 10000–140000
# YOUTUBE_CALLS_PER_HOUR=20     # optional per-user Gemini request quota
# YOUTUBE_CALLS_PER_DAY=60
# SUPABASE_SERVICE_ROLE_KEY=    # supplied automatically by Supabase; used only for the quota RPC
# ALLOWED_ORIGINS=https://your-fretshift.example

# Benchmark-only environment (do not put access tokens in the client build):
# VISION_IMPORT_URL=https://YOUR_PROJECT.supabase.co/functions/v1/vision-import
# FRETSHIFT_USER_ACCESS_TOKEN=  # signed-in FretShift user JWT; NOT the Supabase CLI personal access token
# The benchmark also reads SUPABASE_ANON_KEY from the environment.
# Optional non-destructive smoke test: FRETSHIFT_APP_ORIGIN=http://127.0.0.1:5173

# YouTube benchmark (scripts/bench-youtube.mjs). Without these it runs SIMULATED and makes no request.
# YOUTUBE_BENCH_LIVE=1          # required for any paid Gemini call
# YOUTUBE_BENCH_MAX_REQUESTS=60 # refuses to start above this
# YOUTUBE_IMPORT_URL=https://YOUR_PROJECT.supabase.co/functions/v1/youtube-import  # or GEMINI_API_KEY for direct calls
