# Public client configuration; copy to .env.local and supply your project values.
VITE_SUPABASE_URL=
# Preferred current public key name:
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy public key name is still supported:
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase Edge Function secrets (never prefix with VITE_):
# SUPABASE_URL=        # supplied automatically by Supabase
# SUPABASE_ANON_KEY=   # supplied automatically by Supabase
# OCR_SPACE_API_KEY=
# ALLOWED_ORIGINS=https://your-fretshift.example

# Benchmark-only environment (do not put access tokens in the client build):
# VISION_IMPORT_URL=https://YOUR_PROJECT.supabase.co/functions/v1/vision-import
# FRETSHIFT_USER_ACCESS_TOKEN=  # signed-in FretShift user JWT; NOT the Supabase CLI personal access token
# The benchmark also reads SUPABASE_ANON_KEY from the environment.
# Optional non-destructive smoke test: FRETSHIFT_APP_ORIGIN=http://127.0.0.1:5173
