{
  "name": "fretshift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . && tsc -b",
    "format": "prettier --write src e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:vision-corpus": "node scripts/generate-vision-corpus.mjs",
    "bench:vision": "node scripts/bench-vision.mjs",
    "bench:audio-intelligence": "node scripts/bench-audio-intelligence.mjs",
    "bench:audio-real": "node scripts/bench-audio-real.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "test:offline": "node scripts/verify-strumming-offline.mjs",
    "bench:audio-notes": "node scripts/bench-audio-notes.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@fontsource/inter": "5.2.6",
    "@fontsource/space-grotesk": "5.2.8",
    "@soundtouchjs/audio-worklet": "2.1.1",
    "@soundtouchjs/core": "2.1.1",
    "@tonejs/midi": "2.0.28",
    "dexie": "4.0.11",
    "fflate": "0.8.3",
    "heic2any": "0.0.4",
    "immer": "10.1.1",
    "lucide-react": "0.468.0",
    "midi-file": "1.2.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "6.30.1",
    "tone": "15.1.22",
    "zod": "3.25.76",
    "zundo": "2.3.0",
    "zustand": "5.0.8",
    "@vercel/analytics": "2.0.1",
    "liquid-glass-react": "1.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.2",
    "fast-check": "4.3.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "6.1.0",
    "vitest": "3.2.4"
  }
}
